{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build active file",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/Graphics/Graphics/main.cpp",
                "${workspaceFolder}/Graphics/Graphics/Cell.cpp",
                "-I${workspaceFolder}/Graphics/Graphics",
                "-L${workspaceFolder}/Graphics/Graphics",
                "-lfreeglut",
                "-lglew32",
                "-lopengl32",
                "-lglu32",
                "-o",
                "${workspaceFolder}/Graphics/Graphics/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Graphics/Graphics"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "compiler: g++"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build and run",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${workspaceFolder}/Graphics/Graphics/main.cpp",
                "${workspaceFolder}/Graphics/Graphics/Cell.cpp",
                "-I${workspaceFolder}/Graphics/Graphics",
                "-L${workspaceFolder}/Graphics/Graphics",
                "-lfreeglut",
                "-lglew32",
                "-lopengl32",
                "-lglu32",
                "-o",
                "${workspaceFolder}/Graphics/Graphics/main.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/Graphics/Graphics"
            },
            "problemMatcher": ["$gcc"],
            "group": "build",
            "detail": "Build and run the maze application"
        }
    ]
}
